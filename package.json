{
	"name": "pos_system",
	"version": "1.0.0",
	"description": "POS Desktop Application",
	"main": "main.js",
	"scripts": {
		"start": "electron .",
		"build": "electron-builder"
	},
	"build": {
		"appId": "com.pos.system",
		"productName": "POS System",
		"asar": true,
		"directories": {
			"output": "dist"
		},
		"files": [
			"main.js",
			"preload.js",
			"package.json"
		],
		"extraResources": [
			{
				"from": "php",
				"to": "php",
				"filter": ["**/*"]
			},
			{
				"from": "../pos_system",
				"to": "pos_system",
				"filter": [
					"**/*",
					"!node_modules/**",
					"!.git/**",
					"!tests/**",
					"!storage/logs/**"
				]
			}
		],
		"win": {
			"target": "nsis",
			"icon": "assets/icon.ico"
		},
		"nsis": {
			"oneClick": false,
			"perMachine": true,
			"allowToChangeInstallationDirectory": true
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Isaac-Amponsah/pos_system.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/Isaac-Amponsah/pos_system/issues"
	},
	"homepage": "https://github.com/Isaac-Amponsah/pos_system#readme",
	"devDependencies": {
		"electron": "^41.10.3",
		"electron-builder": "^26.8.1"
	}
}